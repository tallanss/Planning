# URL de la base PostgreSQL (Neon, Supabase, Vercel Postgres, ...).
# Exemple Neon : postgresql://user:pwd@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/planify?sslmode=require"

# Mot de passe partagé pour accéder à l'app.
# Laissez vide en dev local si vous voulez désactiver l'auth.
APP_PASSWORD=""
